#include "build-info.h"

#include <cstdio>
#include <string>

int LLAMA_BUILD_NUMBER = @LLAMA_BUILD_NUMBER@;
char const * LLAMA_COMMIT = "@LLAMA_BUILD_COMMIT@";
char const * LLAMA_COMPILER = "@BUILD_COMPILER@";
char const * LLAMA_BUILD_TARGET = "@BUILD_TARGET@";

int llama_build_number(void) {
    return LLAMA_BUILD_NUMBER;
}

const char * llama_commit(void) {
    return LLAMA_COMMIT;
}

const char * llama_compiler(void) {
    return LLAMA_COMPILER;
}

const char * llama_build_target(void) {
    return LLAMA_BUILD_TARGET;
}

const char * llama_build_info(void) {
    // Lumina-Engine build identity (kept independent of the upstream git commit count).
    // Derived from LLAMA_BUILD_NUMBER so the banner can never drift from --version.
    static const std::string s =
        "Build " + std::to_string(LLAMA_BUILD_NUMBER) + " (Based on llama.cpp b-10991)";
    return s.c_str();
}

const char * lumina_project_github(void) {
    return "https://github.com/Happy-380/Lumina-Engine";
}

const char * lumina_project_donate(void) {
    return "https://afdian.com/a/lumi_380";
}

const char * lumina_developer_bilibili(void) {
    return "https://space.bilibili.com/3546376302496335";
}

const char * lumina_ascii_logo(void) {
    return
        "\n"
        "   __                 _\n"
        "  / / _   _ _ __ ___ (_)_ __   __ _\n"
        " / / | | | | '_ ` _ \\| | '_ \\ / _` |\n"
        "/ /__| |_| | | | | | | | | | | (_| |\n"
        "\\____/\\__,_|_| |_| |_|_|_| |_|\\__,_|  Engine\n";
}

void llama_print_lumina_banner(FILE * stream) {
    fprintf(stream, "%s", lumina_ascii_logo());
    fprintf(stream, "\n");
    fprintf(stream, "build      : %s\n", llama_build_info());
    fprintf(stream, "GitHub     : %s\n", lumina_project_github());
    fprintf(stream, "Donate     : %s  (tip the developer / support development)\n", lumina_project_donate());
    fprintf(stream, "Bilibili   : %s\n", lumina_developer_bilibili());
}

void llama_print_build_info(const char * llama_version, FILE * stream) {
    fprintf(stream, "version: %s (build %d, commit %s)\n", llama_version, llama_build_number(), llama_commit());
    fprintf(stream, "built with %s for %s\n", llama_compiler(), llama_build_target());
    llama_print_lumina_banner(stream);
}
